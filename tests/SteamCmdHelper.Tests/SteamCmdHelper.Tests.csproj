<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The app is a Windows Forms exe, so these tests compile the non-UI source files directly instead of
    referencing it. That keeps them runnable with plain "dotnet test" on any OS.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>SteamCmdHelper.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../ModScanner.cs;../../ProjectConfig.cs;../../RequestSender.cs;../../BakedRequestKey.cs;../../Publisher.cs;../../SteamCmdIntegrity.cs;../../SteamCmdOutput.cs;../../SteamLogin.cs;../../UploadedVersions.cs;../../BatchUpload.cs;../../Cli.cs;../../UpdateCheck.cs;../../WorkshopPage.cs;../../UploadHistory.cs;../../WorkshopStatus.cs" Link="App/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
</Project>
