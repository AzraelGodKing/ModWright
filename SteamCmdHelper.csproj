<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>SteamCmdHelper</RootNamespace>
    <AssemblyName>SteamCmdHelper</AssemblyName>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>1.3.0</Version>
    <Product>SteamCMD Helper</Product>
    <Description>One-click Steam Workshop uploads for RimWorld mods, with login handling and progress.</Description>
    <Copyright>Copyright (c) 2026 Azrael</Copyright>
    <!-- Keep the exe's product version to the plain version (no "+commit"): SignPath only signs files whose product
         name and version match what the release asks for (packaging/signpath/artifact-configuration.xml). -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- The test project lives inside this folder; keep its sources out of the app. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);tests/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <!-- The same icon for every window (Theme.AppIcon); ApplicationIcon above is the exe's own icon. -->
    <EmbeddedResource Include="Assets\app.ico" LogicalName="SteamCmdHelper.app.ico" />
  </ItemGroup>
  <!-- Bakes the Linear request key in when one is available at build time; see RequestKey.targets. -->
  <Import Project="RequestKey.targets" />
</Project>
