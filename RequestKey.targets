<Project>
  <!--
    Bakes the Linear request key into the program at build time, so the ? button can send layout requests for
    everyone who uses the exe. The key is never committed. It comes from:

    - the LINEAR_CREATE_API_KEY and LINEAR_TEAM_UUID environment variables (the GitHub workflows fill them from the
      repository secrets of the same names), or
    - for local builds, the git-ignored request.key file in the project folder, with lines
          LINEAR_CREATE_API_KEY=lin_api_...
          LINEAR_TEAM_UUID=<team id>
      (the older two-line form, key on line 1 and team id on line 2, is still read).

    PROJECTID (a Linear project id) and LABELIDS (label ids separated by commas) are optional and read the same way,
    environment first, then request.key. When set, requests are filed into that project with those labels.
    LABELMAP is optional too: "Name=label id" pairs separated by commas (Layout, Bug, Feature, UI, Upload, SteamCMD),
    which add a label for the kind of request and the area it is about.

    The value is stored XOR-masked in a generated source file under obj/, so it is not plain text in the exe. That
    only stops casual snooping; anyone determined can recover it, which is why the key may only create issues.
  -->
  <PropertyGroup>
    <RequestKeyFile Condition="'$(RequestKeyFile)' == ''">$(MSBuildProjectDirectory)\request.key</RequestKeyFile>
  </PropertyGroup>

  <UsingTask TaskName="WriteRequestKeySource" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <ApiKey ParameterType="System.String" />
      <TeamId ParameterType="System.String" />
      <KeyFile ParameterType="System.String" Required="true" />
      <OutputFile ParameterType="System.String" Required="true" />
      <Found ParameterType="System.Boolean" Output="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Text" />
      <Using Namespace="System.Security.Cryptography" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        var key = (ApiKey ?? "").Trim();
        var team = (TeamId ?? "").Trim();
        // Read straight from the environment, not as MSBuild properties, so the names can't clash with SDK properties.
        var project = (Environment.GetEnvironmentVariable("PROJECTID") ?? "").Trim();
        var labels = (Environment.GetEnvironmentVariable("LABELIDS") ?? "").Trim();
        var labelMap = (Environment.GetEnvironmentVariable("LABELMAP") ?? "").Trim();
        if ((key.Length == 0 || team.Length == 0 || project.Length == 0 || labels.Length == 0 || labelMap.Length == 0) && File.Exists(KeyFile))
        {
            var lines = File.ReadAllLines(KeyFile).Select(l => l.Trim()).Where(l => l.Length > 0 && !l.StartsWith("#")).ToArray();
            string fileKey = "", fileTeam = "", fileProject = "", fileLabels = "", fileLabelMap = "";
            foreach (var l in lines)
            {
                var cut = l.IndexOf('=');
                if (cut < 0) cut = l.IndexOf(':');
                if (cut < 0) continue;
                var name = l.Substring(0, cut).Trim();
                var value = l.Substring(cut + 1).Trim().Trim('"');
                if (name == "LINEAR_CREATE_API_KEY") fileKey = value;
                else if (name == "LINEAR_TEAM_UUID") fileTeam = value;
                else if (name == "PROJECTID") fileProject = value;
                else if (name == "LABELIDS") fileLabels = value;
                else if (name == "LABELMAP") fileLabelMap = value;
            }
            if (fileKey.Length == 0 && fileTeam.Length == 0 && lines.Length >= 2) { fileKey = lines[0]; fileTeam = lines[1]; }
            if (key.Length == 0) key = fileKey;
            if (team.Length == 0) team = fileTeam;
            if (project.Length == 0) project = fileProject;
            if (labels.Length == 0) labels = fileLabels;
            if (labelMap.Length == 0) labelMap = fileLabelMap;
        }

        Found = key.Length > 0 && team.Length > 0;
        if (!Found)
        {
            if (File.Exists(OutputFile)) File.Delete(OutputFile);
            return true;
        }

        // Lines: key, team, project, labels, label map (the last three may be empty). Line breaks inside a value would shift the lines.
        // Keep only the GUIDs, whatever surrounds them (quotes, brackets, JSON, names); the app reads them the same way.
        var guid = new System.Text.RegularExpressions.Regex(@"\b[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}\b");
        var labelCount = guid.Matches(labels).Count;
        if (labels.Length > 0 && labelCount == 0)
            Log.LogWarning("LABELIDS is set but holds no Linear label IDs (GUIDs); requests will carry no labels.");
        if (project.Length > 0 && !guid.IsMatch(project))
            Log.LogWarning("PROJECTID is set but holds no Linear project ID (GUID); requests will not go into a project.");
        labels = string.Join(",", guid.Matches(labels).Cast<System.Text.RegularExpressions.Match>().Select(m => m.Value));
        var projectMatch = guid.Match(project);
        project = projectMatch.Success ? projectMatch.Value : "";
        // "Name=id" pairs, kept on one line; the app parses them the same way.
        var pair = new System.Text.RegularExpressions.Regex(@"([A-Za-z][A-Za-z ]*?)[""']?\s*[=:]\s*[""']?(" + guid.ToString().Replace(@"\b", "") + @")\b");
        var pairs = pair.Matches(labelMap).Cast<System.Text.RegularExpressions.Match>().Select(m => m.Groups[1].Value.Trim() + "=" + m.Groups[2].Value).ToArray();
        if (labelMap.Length > 0 && pairs.Length == 0)
            Log.LogWarning("LABELMAP is set but holds no Name=label id pairs; requests will carry no kind or area labels.");
        labelMap = string.Join(",", pairs);
        var data = Encoding.UTF8.GetBytes(key + "\n" + team + "\n" + project + "\n" + labels + "\n" + labelMap);
        Log.LogMessage(MessageImportance.High, "Linear request route: " + (project.Length > 0 ? "project set" : "no project")
            + ", " + labelCount + " label(s), " + pairs.Length + " mapped label(s)");
        byte[] mask;
        using (var sha = SHA256.Create()) mask = sha.ComputeHash(Encoding.UTF8.GetBytes("SteamCmdHelper request key " + key + team));
        var masked = data.Select((b, i) => (byte)(b ^ mask[i % mask.Length])).ToArray();
        var src = "// <auto-generated>Written at build time by RequestKey.targets. Never commit this file.</auto-generated>\n"
            + "#nullable enable\nnamespace SteamCmdHelper;\n\nstatic partial class BakedRequestKey\n{\n"
            + "    static partial void Fill(ref byte[]? data, ref byte[]? mask)\n    {\n"
            + "        data = new byte[] { " + string.Join(", ", masked) + " };\n"
            + "        mask = new byte[] { " + string.Join(", ", mask) + " };\n"
            + "    }\n}\n";
        Directory.CreateDirectory(Path.GetDirectoryName(OutputFile));
        if (!File.Exists(OutputFile) || File.ReadAllText(OutputFile) != src) File.WriteAllText(OutputFile, src);
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="BakeRequestKey" BeforeTargets="CoreCompile">
    <!-- Set here, not at the top: IntermediateOutputPath is only known once the SDK targets have been read. -->
    <PropertyGroup>
      <RequestKeySource>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'RequestKey.g.cs'))</RequestKeySource>
    </PropertyGroup>
    <WriteRequestKeySource ApiKey="$(LINEAR_CREATE_API_KEY)" TeamId="$(LINEAR_TEAM_UUID)" KeyFile="$(RequestKeyFile)" OutputFile="$(RequestKeySource)">
      <Output TaskParameter="Found" PropertyName="_RequestKeyFound" />
    </WriteRequestKeySource>
    <ItemGroup Condition="'$(_RequestKeyFound)' == 'true'">
      <Compile Include="$(RequestKeySource)" />
      <FileWrites Include="$(RequestKeySource)" />
    </ItemGroup>
    <Message Importance="high" Condition="'$(_RequestKeyFound)' == 'true'" Text="Linear request key: baked in" />
    <Message Importance="high" Condition="'$(_RequestKeyFound)' != 'true'" Text="Linear request key: none found (the ? button will open a pre-filled issue instead)" />
  </Target>
</Project>
